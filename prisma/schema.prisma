// =========================================================
// VIET CITY WEAR - PRISMA SCHEMA (PostgreSQL)
// Khớp với database script mới
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// USER
// Role: constant (vd: 'Admin', 'Customer')
// =========================================================
model User {
  UserId    Int       @id @default(autoincrement())
  Email     String    @unique @db.VarChar(150)
  FullName  String    @db.VarChar(100)
  Phone     String?   @db.VarChar(10)
  Password  String    @db.VarChar(255)
  Address   String?   @db.VarChar(255)
  Role      String    @db.VarChar(30)
  CreatedAt DateTime  @default(now())

  orders    Order[]
  blogs     Blog[]

  @@map("User")
}

// =========================================================
// CITY
// =========================================================
model City {
  CityId      Int       @id @default(autoincrement())
  Name        String    @db.VarChar(100)
  Description String?   @db.Text
  CoverImage  String?   @db.VarChar(500)

  landmarks   Landmark[]
  foodSpots   FoodSpot[]
  products    Product[]

  @@map("City")
}

// =========================================================
// LANDMARK
// =========================================================
model Landmark {
  LandmarkId Int       @id @default(autoincrement())
  CityId     Int
  Name       String    @db.VarChar(150)
  Story      String?   @db.Text
  History    String?   @db.Text
  OrderIndex Int       @default(0)

  city            City              @relation(fields: [CityId], references: [CityId])
  media           LandmarkMedia[]
  travelTimeline  TravelTimeline[]

  @@map("Landmark")
}

// =========================================================
// LANDMARK MEDIA
// Type: constant (vd: 'Image', 'Video')
// =========================================================
model LandmarkMedia {
  MediaId    Int       @id @default(autoincrement())
  LandmarkId Int
  Type       String    @db.VarChar(30)
  Url        String    @db.VarChar(500)
  Caption    String?   @db.VarChar(255)

  landmark   Landmark  @relation(fields: [LandmarkId], references: [LandmarkId])

  @@map("LandmarkMedia")
}

// =========================================================
// TRAVEL TIMELINE
// =========================================================
model TravelTimeline {
  Id         Int       @id @default(autoincrement())
  LandmarkId Int
  StepOrder  Int
  Duration   String?   @db.VarChar(50)
  Note       String?   @db.VarChar(255)

  landmark   Landmark  @relation(fields: [LandmarkId], references: [LandmarkId])

  @@map("TravelTimeline")
}

// =========================================================
// FOOD SPOT
// =========================================================
model FoodSpot {
  FoodSpotId  Int       @id @default(autoincrement())
  CityId      Int
  Name        String    @db.VarChar(150)
  Description String?   @db.Text
  ImageUrl    String?   @db.VarChar(500)
  MapLink     String?   @db.VarChar(500)

  city        City      @relation(fields: [CityId], references: [CityId])

  @@map("FoodSpot")
}

// =========================================================
// PRODUCT
// Status: constant (vd: 'Active', 'Inactive', 'OutOfStock')
// =========================================================
model Product {
  ProductId   Int       @id @default(autoincrement())
  CityId      Int
  Name        String    @db.VarChar(150)
  BasePrice   Decimal   @db.Decimal(18, 2)
  Description String?   @db.Text
  SizeGuide   String?   @db.Text
  Status      String    @db.VarChar(30)
  CreatedAt   DateTime  @default(now())

  city         City               @relation(fields: [CityId], references: [CityId])
  variants     ProductVariant[]
  accessories  ProductAccessory[]
  nfcTags      NFCTag[]

  @@map("Product")
}

// =========================================================
// PRODUCT VARIANT
// =========================================================
model ProductVariant {
  VariantId     Int       @id @default(autoincrement())
  ProductId     Int
  Image         String?   @db.VarChar(500)
  Color         String    @db.VarChar(50)
  Size          String    @db.VarChar(10)
  Price         Decimal   @db.Decimal(18, 2)
  StockQuantity Int       @default(0)

  product       Product     @relation(fields: [ProductId], references: [ProductId])
  orderItems    OrderItem[]

  @@map("ProductVariant")
}

// =========================================================
// PRODUCT ACCESSORY
// Type: constant (vd: 'LandmarkCard', 'NfcKeychain')
// =========================================================
model ProductAccessory {
  AccessoryId Int       @id @default(autoincrement())
  ProductId   Int
  Type        String    @db.VarChar(30)
  Name        String    @db.VarChar(100)
  Quantity    Int       @default(1)

  product     Product   @relation(fields: [ProductId], references: [ProductId])

  @@map("ProductAccessory")
}

// =========================================================
// NFC TAG
// =========================================================
model NFCTag {
  NfcId     Int       @id @default(autoincrement())
  NfcCode   String    @unique @db.VarChar(50)
  ProductId Int
  ScanCount Int       @default(0)
  CreatedAt DateTime  @default(now())

  product   Product   @relation(fields: [ProductId], references: [ProductId])

  @@map("NFCTag")
}

// =========================================================
// ORDER
// Status: constant (vd: 'Pending', 'Processing', 'Shipped', 'Completed', 'Cancelled')
// PaymentMethod: constant (vd: 'COD')
// =========================================================
model Order {
  OrderId       Int       @id @default(autoincrement())
  UserId        Int
  TotalAmount   Decimal   @db.Decimal(18, 2)
  Status        String    @db.VarChar(30)
  PaymentMethod String    @db.VarChar(30)
  CreatedAt     DateTime  @default(now())

  user          User        @relation(fields: [UserId], references: [UserId])
  items         OrderItem[]

  @@map("Order")
}

// =========================================================
// ORDER ITEM
// =========================================================
model OrderItem {
  OrderItemId Int       @id @default(autoincrement())
  OrderId     Int
  VariantId   Int
  Quantity    Int
  UnitPrice   Decimal   @db.Decimal(18, 2)

  order       Order           @relation(fields: [OrderId], references: [OrderId])
  variant     ProductVariant  @relation(fields: [VariantId], references: [VariantId])

  @@map("OrderItem")
}

// =========================================================
// BLOG
// Category, Status: constant (vd: Category 'Culture'/'Travel'/'Landmark', Status 'Draft'/'Published')
// =========================================================
model Blog {
  BlogId      Int       @id @default(autoincrement())
  AuthorId    Int
  Title       String    @db.VarChar(200)
  Content     String?   @db.Text
  CoverImage  String?   @db.VarChar(500)
  Category    String?   @db.VarChar(50)
  Status      String    @db.VarChar(30)
  PublishedAt DateTime?

  author      User      @relation(fields: [AuthorId], references: [UserId])

  @@map("Blog")
}
