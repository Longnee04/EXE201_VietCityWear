# =============================================================
# VIET CITY WEAR - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# =============================================================
# Hướng dẫn: Tạo bản sao tệp này thành .env và điền thông tin thực tế
# Lệnh copy: cp .env.example .env

# 1. KẾT NỐI SUPABASE
# Lấy tại Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Chỉ dùng ở backend / Server Actions

# 2. KẾT NỐI DATABASE (Direct / Pooler)
# Cấu trúc: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres.xxxx:mypassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# 3. NEXT.JS APP CONFIG
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. AUTHENTICATION & SECURITY
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Đăng nhập Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. TÍCH HỢP AI DU LỊCH BẢN ĐỊA (Google Gemini API)
GOOGLE_GEMINI_API_KEY=""

# 6. CỔNG THANH TOÁN (Mở rộng sau này: VNPay / MoMo)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
