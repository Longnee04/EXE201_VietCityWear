# =============================================================
# VIET CITY WEAR - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# =============================================================
# Hướng dẫn: Tạo bản sao tệp này thành .env và điền thông tin thực tế
# Lệnh copy: cp .env.example .env

# 1. KẾT NỐI DATABASE (PostgreSQL)
# Cấu trúc: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
# Ví dụ local: postgresql://postgres:postgres@localhost:5432/vietcitywear?schema=public
# Ví dụ Supabase / Neon: postgresql://postgres.xxxx:mypassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vietcitywear?schema=public"

# 2. NEXT.JS APP CONFIG
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. AUTHENTICATION (NextAuth hoặc JWT - Tùy chọn mở rộng)
# Sinh chuỗi bí mật bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Đăng nhập Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. TÍCH HỢP AI DU LỊCH BẢN ĐỊA (Google Gemini API)
# Lấy key miễn phí tại: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=""

# 5. CỔNG THANH TOÁN (Mở rộng sau này: VNPay / MoMo)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
